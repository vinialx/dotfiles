[
  {
    /* global settings. */
    "height": 55,
    "layer": "top",
    "position": "top",
    /* modules organization. */
    "modules-left": [
      "custom/nixos",
      "hyprland/workspaces",
      "custom/clipboard",
      "group/media"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "cpu",
      "memory",
      "temperature",
      "battery",
      "custom/settings",
      "custom/notification",
      "custom/turnoff"
    ],

    /* modules. */
    "custom/nixos": {
      "format": "󱄅",
      "tooltip": false,
      "on-click": "/home/vinicius/dotfiles/scripts/reload-wallpaper.sh"
    },
    "battery": {
      "format": "{capacity}% {icon}",
      "format-charging": "{capacity}% 󰂄",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "interval": 60
    },
    "clock": {
      "format": "{:%a, %d %b %H:%M:%S}",
      "interval": 1,
      "tooltip": false
    },
    "memory": {
      "format": "  {used:0.1f} GB",
      "tooltip": false,
      "interval": 5
    },
    "cpu": {
      "format": "  {}%",
      "tooltip": false,
      "interval": 10
    },
    "temperature": {
      "format": "{temperatureC}°C",
      "tooltip": false
    },
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate"
    },

    /* media player. */
    "mpris": {
      "player": "playerctld",
      "format-playing": " {artist} - {title}",
      "format-paused": " {artist} - {title}",
      "format-stopped": "",
      "max-length": 30,
      "interval": 1
    },
    "custom/media-prev": {
      "format": "󰒮",
      "on-click": "playerctl -p playerctld previous",
      "tooltip": false
    },
    "custom/media-playpause": {
      "exec": "playerctl -p playerctld status 2>/dev/null | grep -q Playing && echo '󰏤' || echo '󰐊'",
      "interval": 1,
      "on-click": "playerctl -p playerctld play-pause",
      "tooltip": false
    },
    "custom/media-next": {
      "format": "󰒭",
      "on-click": "playerctl -p playerctld next",
      "tooltip": false
    },
    "group/media": {
      "orientation": "horizontal",
      "modules": [
        "custom/media-prev",
        "custom/media-playpause",
        "custom/media-next",
        "mpris"
      ]
    },

    /* turnoff. */
    "custom/turnoff": {
      "format": "󰐥",
      "on-click": "nwg-bar -p right",
      "tooltip": false
    },

    /* settings. */
    "custom/settings": {
      "format": "",
      "exec": "orbit waybar-status",
      "return-type": "json",
      "interval": 10,
      "on-click": "orbit toggle top-right",
      "tooltip": false
    },

      "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
    /* clipboard */
    "custom/clipboard": {
      "format": "󱓦",
      "on-click": "/home/vinicius/dotfiles/scripts/clipboard-menu.sh",
      "tooltip": false
    }
  }
]
