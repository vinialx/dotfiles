* {
    background:     rgba(0, 0, 0, 0.85);
    background-alt: rgba(255, 255, 255, 0.06);
    foreground:     #ffffff;
    accent:         #ffffff;
    selected-text:  #000000;

    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    background-color: @background;
    text-color:       @foreground;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.25);
    border-radius:    16px;
    width:            650px;
    padding:          20px;
}

mainbox {
    spacing:          15px;
    background-color: transparent;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @background-alt;
    border-radius:    10px;
    padding:          12px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    enabled:          true;
    text-color:       @accent;
}

entry {
    placeholder:       "Buscar no histórico...";
    placeholder-color: rgba(255, 255, 255, 0.35);
    text-color:        @foreground;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            10;
    spacing:          4px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @foreground;
    border-radius:    8px;
    padding:          10px 12px;
}

element selected {
    background-color: @accent;
    text-color:       @selected-text;
}

element-text {
    text-color:       inherit;
    highlight:        bold rgba(255, 255, 255, 0.6);
}
